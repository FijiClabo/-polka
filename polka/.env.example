# =============================================================================
#  Дочитка — настройки. Скопируй в .env и заполни:  cp .env.example .env
#  Строки с пометкой [ОБЯЗАТЕЛЬНО] без значения не заработают.
# =============================================================================

# ---------- Сервер и домен --------------------------------------------------
# [ОБЯЗАТЕЛЬНО] Домен, направленный на IP сервера (A-запись). Без https://
DOMAIN=dochitka.example.ru
# [ОБЯЗАТЕЛЬНО] Тот же домен с https:// — адрес для webhook и мини-приложения
PUBLIC_URL=https://dochitka.example.ru
# Пароль базы данных (придумай любой длинный)
POSTGRES_PASSWORD=change-me-long-random-password

# ---------- Telegram --------------------------------------------------------
# [ОБЯЗАТЕЛЬНО] Токен бота от @BotFather
BOT_TOKEN=
# webhook — на сервере; polling — для запуска на своём компьютере без домена
BOT_MODE=webhook
# Секрет webhook (защищает от подделки запросов). Оставь пустым — deploy.sh создаст случайный сам
WEBHOOK_SECRET=
# [ОБЯЗАТЕЛЬНО] tg_id админов через запятую (узнать свой: написать @userinfobot)
ADMIN_TG_IDS=
# Контакт для вопросов участников, показывается в /help (например, @username)
SUPPORT_CONTACT=

# ---------- Продукт ---------------------------------------------------------
# Название не зашито в код — можно поменять здесь
PROJECT_NAME=Дочитка
# Бесплатный 7-дневный спринт всем новичкам (true), а не только пришедшим по ссылке друга
SPRINT_FOR_EVERYONE=true

# ---------- Цены -------------------------------------------------------------
# Рубли — для оплаты на сайте, звёзды — для оплаты в Telegram. Забег = одна книга до финиша.
PRICE_RUN_RUB=990
PRICE_MONTH_RUB=299
PRICE_YEAR_RUB=1990
PRICE_RUN_STARS=650
PRICE_MONTH_STARS=200
PRICE_YEAR_STARS=1300
# Гарантия: возврат без вопросов в первые N дней (один раз на человека)
REFUND_DAYS=3

# ---------- Оплата в Telegram: звёзды ------------------------------------------
# Правило Telegram: цифровые услуги в боте продаются только за звёзды. Договор не нужен,
# включено по умолчанию. Звёзды выводятся через Fragment (в TON) — уточни у бухгалтера.
PAYMENTS_STARS=true

# ---------- Оплата на сайте: рубли через ЮKassa --------------------------------
# Карта, СБП, SberPay, T-Pay. Покупатель платит на сайте, получает код и активирует его в боте.
# Личный кабинет ЮKassa → Интеграция → Ключи API: shopId и секретный ключ.
# Там же → HTTP-уведомления: адрес https://<твой домен>/pay/yookassa, события payment.succeeded,
# payment.canceled, refund.succeeded.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чеки 54-ФЗ через «Чеки от ЮKassa» (для ИП). Самозанятому — false и чек в «Мой налог»
FISCAL_RECEIPTS=true
# 1 — без НДС (УСН, самозанятые)
RECEIPT_VAT_CODE=1

# Письмо с кодом активации покупателю (необязательно: код и так показывается на странице оплаты)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Запасной путь: перевод вручную, доступ выдаёт админ командой /grant. Этот текст бот покажет,
# если ни звёзды, ни сайт не подключены.
PAYMENT_INFO=Можно оплатить переводом — напиши в поддержку, доступ откроют вручную.

# ---------- Продавец: для оферты, чеков и подвала сайта ------------------------
# ФИО или «ИП Иванов И. И.», статус (ИП / самозанятый / ООО), ИНН, ОГРНИП (для ИП), e-mail для претензий
SELLER_NAME=
SELLER_STATUS=ИП
SELLER_INN=
SELLER_OGRN=
SELLER_EMAIL=
SELLER_PHONE=
# Версия документов: меняй при правке оферты/политики — пишется в платежи и журнал согласий
OFFER_VERSION=2026-10-07
LEGAL_DOCS_DATE=2026-10-07

# ---------- ИИ: проверка пересказов ----------------------------------------
# Порядок провайдеров: первый — основной, второй — запасной.
# anthropic (Claude) | yandex (YandexGPT) | demo (заглушка без ключей, только для просмотра)
LLM_PROVIDERS=anthropic,yandex

# Claude (console.anthropic.com → API Keys). API недоступен с российских IP: если сервер в РФ —
# укажи ANTHROPIC_BASE_URL своего прокси за рубежом или поставь первым провайдером yandex.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Модель для проверки пересказов и дешёвая модель для кратких содержаний отрезков
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
# Глубина «размышления» модели: low достаточно для проверки пересказа и дешевле всего
ANTHROPIC_EFFORT=low

# YandexGPT и SpeechKit (Yandex Cloud: сервисный аккаунт с ролями
# ai.languageModels.user и ai.speechkit-stt.user → API-ключ; ID каталога)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEXGPT_MODEL=yandexgpt/latest
YANDEXGPT_MODEL_CHEAP=yandexgpt-lite/latest

# ---------- Голос в текст ----------------------------------------------------
# yandex (SpeechKit, ключ выше) | whisper (любой Whisper-совместимый API)
STT_PROVIDER=yandex
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# ---------- Сеть ------------------------------------------------------------
# Свой адрес Bot API (прокси к api.telegram.org), если сервер в РФ и Telegram оттуда недоступен
TELEGRAM_API_BASE=

# ---------- Отладка ----------------------------------------------------------
# Ускоренное время: «сутки» длятся N минут (0 — обычное время). Только для тестового прогона!
FAST_DAY_MINUTES=0
# Разрешить ведущему команду /timewarp N (сдвинуть часы бота на N часов вперёд)
ALLOW_TIMEWARP=false
LOG_LEVEL=INFO
