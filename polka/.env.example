# =============================================================================
#  Полка — настройки. Скопируй в .env и заполни:  cp .env.example .env
#  Строки с пометкой [ОБЯЗАТЕЛЬНО] без значения не заработают.
# =============================================================================

# ---------- Сервер и домен --------------------------------------------------
# [ОБЯЗАТЕЛЬНО] Домен, направленный на IP сервера (A-запись). Без https://
DOMAIN=polka.example.ru
# [ОБЯЗАТЕЛЬНО] Тот же домен с https:// — адрес для webhook и мини-приложения
PUBLIC_URL=https://polka.example.ru
# Пароль базы данных (придумай любой длинный)
POSTGRES_PASSWORD=change-me-long-random-password

# ---------- Telegram --------------------------------------------------------
# [ОБЯЗАТЕЛЬНО] Токен бота от @BotFather
BOT_TOKEN=
# webhook — на сервере; polling — для запуска на своём компьютере без домена
BOT_MODE=webhook
# Секрет webhook: любая строка из латиницы и цифр (защищает от подделки запросов)
WEBHOOK_SECRET=change-me-random-string
# [ОБЯЗАТЕЛЬНО] tg_id админов через запятую (узнать свой: написать @userinfobot)
ADMIN_TG_IDS=
# Контакт для вопросов участников, показывается в /help (например, @username)
SUPPORT_CONTACT=

# ---------- Продукт ---------------------------------------------------------
# Название не зашито в код — можно поменять здесь (Полка / Дочитал / Закладка / Вслух)
PROJECT_NAME=Полка
# Текст с реквизитами оплаты — бот покажет его тем, кто ждёт оплаты
PAYMENT_INFO=Оплата забега — 990 ₽ переводом. Реквизиты: ... После оплаты напиши ведущему, доступ откроется.
# Предлагать бесплатный спринт всем новичкам, а не только пришедшим по ссылке друга
SPRINT_FOR_EVERYONE=false

# ---------- ИИ: проверка пересказов ----------------------------------------
# Порядок провайдеров: первый — основной, второй — запасной.
# anthropic (Claude) | yandex (YandexGPT) | demo (заглушка без ключей, только для просмотра)
LLM_PROVIDERS=anthropic,yandex

# Claude (console.anthropic.com → API Keys). Сервер должен быть вне РФ — API недоступен из России.
ANTHROPIC_API_KEY=
# Модель для проверки пересказов и дешёвая модель для кратких содержаний отрезков
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
# Глубина «размышления» модели: low достаточно для проверки пересказа и дешевле всего
ANTHROPIC_EFFORT=low

# YandexGPT и SpeechKit (Yandex Cloud: сервисный аккаунт с ролями
# ai.languageModels.user и ai.speechkit-stt.user → API-ключ; ID каталога)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEXGPT_MODEL=yandexgpt/latest
YANDEXGPT_MODEL_CHEAP=yandexgpt-lite/latest

# ---------- Голос в текст ----------------------------------------------------
# yandex (SpeechKit, ключ выше) | whisper (любой Whisper-совместимый API)
STT_PROVIDER=yandex
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# ---------- Отладка ----------------------------------------------------------
# Ускоренное время: «сутки» длятся N минут (0 — обычное время). Только для тестового прогона!
FAST_DAY_MINUTES=0
# Разрешить ведущему команду /timewarp N (сдвинуть часы бота на N часов вперёд)
ALLOW_TIMEWARP=false
LOG_LEVEL=INFO
